rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCircleMember(circleId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.members;
    }

    // A non-member joining via an invite code has to be able to write
    // themselves into `members` before isCircleMember would ever be
    // true for them — this is the one, narrow exception: the caller may
    // add ONLY their own uid to `members` and change nothing else about
    // the circle, and only if they weren't already a member.
    function isSelfJoin() {
      return isSignedIn() &&
        !(request.auth.uid in resource.data.members) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members"]) &&
        request.resource.data.members == resource.data.members.concat([request.auth.uid]);
    }

    // /users/{userId} — every user can read any profile (display names
    // are shown across circles). Creating/renaming/etc. a profile is
    // always restricted to its own owner. Updates get one narrow
    // carve-out: any signed-in user may bump another member's
    // stats/unlockedFrames, since snap-count milestones and challenge-win
    // rewards are paid out client-side (no Cloud Functions on the Spark
    // plan — see recordSnapSent/awardChallengeRewards) and can touch
    // teammates' or opponents' docs, not just the caller's own. Every
    // other field (displayName, email, avatarId, ...) still requires the
    // doc to be the requester's own.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stats", "unlockedFrames"])
      );
      allow delete: if false;

      // /users/{userId}/snaps/{snapId} — the owner's personal mirror of
      // every snap they've ever sent (see submitSnap), independent of
      // circle membership. Owner-only in both directions: this is a
      // private, personal archive, not something other users read.
      match /snaps/{snapId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId;

        // Write-once, with one narrow carve-out: the owner may still
        // reposition this snap on their Gallery Wall, pick a frame for
        // it, and flip onWall when adding/removing it from the wall via
        // the Memories flow. Every other field (circleId, imageUrl,
        // submittedAt) is immutable once created.
        allow update: if isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["positionIndex", "wallOffset", "wallCrossFrac", "wallSize", "frameId", "onWall"]);

        allow delete: if false;
      }
    }

    // /prompts/{promptId} — shared content bank. Any signed-in user can
    // add prompts (there's no admin role yet — this is what the dev
    // seed utility relies on) but never edit/delete one after the fact.
    match /prompts/{promptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // /joinCodes/{code} — a lightweight code -> circleId lookup, kept
    // separate from /circles (which stays member-only to read) so a
    // non-member can resolve an invite code to find which circle to
    // join without exposing the whole circles collection — its
    // members, wagers, join codes — to enumeration by anyone signed in.
    match /joinCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /circles/{circleId} {
      allow read: if isCircleMember(circleId);
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.creatorId
        && request.auth.uid in request.resource.data.members;
      allow update: if isCircleMember(circleId) || isSelfJoin();
      allow delete: if false;

      // /circles/{circleId}/snaps/{snapId} — a circle member can send a
      // photo at any time, not just while a challenge is active. When
      // challengeId is set, this re-verifies server-side that the
      // referenced challenge is genuinely active (and, for
      // time-sensitive prompts, not past its own endsAt) before letting
      // the write claim it — a stale or spoofed challengeId is
      // rejected outright rather than silently scored. challengeId ==
      // null is always allowed: an unscored snap just for the circle.
      match /snaps/{snapId} {
        allow read: if isCircleMember(circleId);

        allow create: if isCircleMember(circleId)
          && request.auth.uid == request.resource.data.userId
          && (
            request.resource.data.challengeId == null ||
            (
              get(/databases/$(database)/documents/circles/$(circleId)/challenges/$(request.resource.data.challengeId)).data.status == "active" &&
              (
                get(/databases/$(database)/documents/circles/$(circleId)/challenges/$(request.resource.data.challengeId)).data.timeline.endsAt == null ||
                request.time <= get(/databases/$(database)/documents/circles/$(circleId)/challenges/$(request.resource.data.challengeId)).data.timeline.endsAt
              )
            )
          );

        // Genuinely write-once now — Gallery Wall placement/frame/onWall
        // moved to the sender's personal snap mirror below, so nothing
        // about a circle snap is ever edited after creation.
        allow update: if false;

        allow delete: if false;
      }

      match /challenges/{challengeId} {
        allow read: if isCircleMember(circleId);

        allow create: if isCircleMember(circleId)
          && request.auth.uid == request.resource.data.createdBy
          && request.auth.uid in request.resource.data.agreementStatus;

        // A challenge's wager/timeline/status can only move through
        // this state machine, and wager/timeline are frozen the moment
        // status leaves "setup" — enforced here, not just client-side,
        // since two members' clients could otherwise race each other.
        allow update: if isCircleMember(circleId) && (
          // setup: any member of this challenge may edit the
          // wager/duration/agreementStatus (proposeWagerAndTimeline
          // resets every member's agreement, so any key in that map
          // may change here), trigger the auto-lock transition
          // (setup -> locked, or setup -> active for daily prompts,
          // which have no separate "start" step), and grow `teams` —
          // setMemberAgreement drops each member onto a team the moment
          // they agree, so team assignments fill in gradually during
          // setup rather than being frozen at creation.
          (
            resource.data.status == "setup" &&
            request.auth.uid in resource.data.agreementStatus &&
            request.resource.data.promptId == resource.data.promptId &&
            request.resource.data.promptText == resource.data.promptText &&
            request.resource.data.promptType == resource.data.promptType &&
            request.resource.data.createdBy == resource.data.createdBy &&
            (request.resource.data.status == "setup" ||
             request.resource.data.status == "locked" ||
             request.resource.data.status == "active")
          ) ||
          // locked -> active: starting a time-sensitive challenge's
          // countdown. Only status + timeline.startedAt/endsAt move;
          // the negotiated wager/duration stay frozen.
          (
            resource.data.status == "locked" &&
            request.resource.data.status == "active" &&
            request.resource.data.wager == resource.data.wager &&
            request.resource.data.timeline.durationHours == resource.data.timeline.durationHours &&
            request.resource.data.agreementStatus == resource.data.agreementStatus
          ) ||
          // active -> completed: only the status field may change —
          // the opportunistic "nothing left to do" transition, since
          // there's no Cloud Function to do this the instant it's true.
          (
            resource.data.status == "active" &&
            request.resource.data.status == "completed" &&
            request.resource.data.wager == resource.data.wager &&
            request.resource.data.timeline == resource.data.timeline &&
            request.resource.data.agreementStatus == resource.data.agreementStatus
          ) ||
          // completed: the one-time rewardsGranted flag may flip to true,
          // marking that challengesCompleted/frameWin have been paid out
          // for this challenge (see awardChallengeRewards) — everything
          // else about a completed challenge stays frozen.
          (
            resource.data.status == "completed" &&
            request.resource.data.status == "completed" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rewardsGranted"]) &&
            request.resource.data.rewardsGranted == true
          )
        );

        allow delete: if false;

        match /scoringEvents/{eventId} {
          allow read: if isCircleMember(circleId);
          allow create: if isCircleMember(circleId) && request.auth.uid == request.resource.data.userId;
          allow update, delete: if false;
        }
      }
    }
  }
}
